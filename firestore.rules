rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Admins:
    // Read & Write allowed so administrators can manage authorized admin accounts
    match /admins/{adminEmail} {
      allow read, write: if true;
    }

    // 2. System Settings (registrationPeriod, templateItems, uploadSlots, googleDrive):
    // Read & Write allowed so administrators can configure registration dates, templates, and slots
    match /systemSettings/{settingId} {
      allow read, write: if true;
    }

    // 3. Audit Logs:
    // Read: allowed for system review
    // Create: allowed so all important operations are recorded
    // Update & Delete: strictly forbidden to maintain an immutable audit trail
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // 4. Registered Users:
    // Read & Write allowed for school registration and profile management
    match /users/{userEmail} {
      allow read, write: if true;
    }

    // 5. School Files:
    // Read & Write allowed for representatives managing their files and admin dashboard
    match /schoolFiles/{fileId} {
      allow read, write: if true;
    }

    // Default catch-all: deny all unlisted operations
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

